def clean_dir_name(name):
    """Clean a string to be used as a directory name."""
    if not name:
        return "unknown"
    # Replace any non-alphanumeric character (except space and hyphen) with underscore
    cleaned = "".join(c if c.isalnum() or c in ' -' else '_' for c in name)
    # Replace spaces and hyphens with underscores
    cleaned = cleaned.replace(' ', '_').replace('-', '_')
    # Collapse multiple underscores
    while '__' in cleaned:
        cleaned = cleaned.replace('__', '_')
    # Remove leading/trailing underscores
    cleaned = cleaned.strip('_')
    return cleaned if cleaned else 'unknown'
