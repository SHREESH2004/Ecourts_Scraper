def choose_high_court(state_arg=None, court_arg=None):
    """Show named state/court options and return the selected eCourts codes."""
    states = sorted({(state_code, state_name) for state_code, _, state_name, _ in HIGH_COURTS}, key=lambda item: item[1].casefold())
    if state_arg is None:
        print("\nAvailable High Court states:")
        for state_code, state_name in states:
            aliases = [name.title() for name, code in STATE_ALIASES.items() if code == state_code and name.casefold() != state_name.casefold()]
            label = f"{state_name} ({', '.join(aliases)})" if aliases else state_name
            print(f"  State code {state_code}: {label}")
        state_arg = input("Enter a state name or code: ").strip()

    state_key = str(state_arg).strip().casefold()
    state_code = STATE_ALIASES.get(state_key, str(state_arg).strip())
    matching_states = [item for item in states if item[0] == state_code or item[1].casefold() == state_key]
    if not matching_states:
        raise ValueError(f"Unknown High Court state/name/code: {state_arg!r}")
    state_code, state_name = matching_states[0]
    courts = [row for row in HIGH_COURTS if row[0] == state_code]

    if court_arg is None:
        print(f"\nHigh Courts and benches for {state_name} (state code {state_code}):")
        for index, (_, code, _, name) in enumerate(courts, 1):
            effective_code = code or "1 (default)"
            print(f"  {index}. {name} — court code {effective_code}")
        while True:
            choice = input("Choose a court by list number: ").strip()
            try:
                court_index = int(choice) - 1
                if 0 <= court_index < len(courts):
                    break
            except ValueError:
                pass
            print(f"Enter a number from 1 to {len(courts)}")
        selected = courts[court_index]
    else:
        requested_code = str(court_arg).strip()
        selected_options = [row for row in courts if (row[1] or "1") == requested_code]
        if not selected_options:
            raise ValueError(f"Court code {requested_code!r} is not listed for {state_name}")
        selected = selected_options[0]

    return state_code, selected[1], state_name, selected[3]

