def get_postgres_connection():
    """Create and return PostgreSQL connection if enabled and available"""
    if not POSTGRES_ENABLED or not POSTGRES_AVAILABLE:
        return None
    try:
        conn = psycopg2.connect(
            host=POSTGRES_HOST,
            port=POSTGRES_PORT,
            database=POSTGRES_DB,
            user=POSTGRES_USER,
            password=POSTGRES_PASSWORD
        )
        return conn
    except Exception as e:
        print(f"Warning: Could not connect to PostgreSQL: {e}")
        print("PostgreSQL is unavailable; database writes cannot run.")
        return None

def init_postgres_table():
    """Initialize the PostgreSQL table if it doesn't exist"""
    conn = get_postgres_connection()
    if not conn:
        return False
    try:
        cursor = conn.cursor()
        cursor.execute("""CREATE TABLE IF NOT EXISTS eCourts_pdfs (
            id SERIAL PRIMARY KEY, timestamp_utc TIMESTAMPTZ, local_pdf_path TEXT,
            pdf_filename TEXT, judge_names TEXT, cause_list_type TEXT,
            cause_list_date DATE, bench_id TEXT, cause_list_id TEXT,
            eliminated BOOLEAN, file_size_bytes INTEGER, download_status TEXT,
            content_type TEXT, judge_name TEXT, reference_name TEXT,
            state_code TEXT, district_code TEXT, court_code TEXT)""")
        for column in ('judge_name', 'reference_name', 'state_code', 'district_code', 'court_code'):
            cursor.execute(f"ALTER TABLE ecourts_pdfs ADD COLUMN IF NOT EXISTS {column} TEXT")
        cursor.execute("""CREATE TABLE IF NOT EXISTS scraper_runs (
            id BIGSERIAL PRIMARY KEY, started_at TIMESTAMPTZ NOT NULL,
            finished_at TIMESTAMPTZ, state_code TEXT, district_code TEXT,
            court_code TEXT, status TEXT NOT NULL, cause_lists INTEGER DEFAULT 0,
            pdfs_downloaded INTEGER DEFAULT 0, pdfs_skipped INTEGER DEFAULT 0,
            error TEXT)""")
        conn.commit()
        cursor.close()
        conn.close()
        print("[OK] PostgreSQL tables ensured: ecourts_pdfs, scraper_runs")
        return True
    except Exception as e:
        print(f"Warning: Could not initialize PostgreSQL tables: {e}")
        conn.rollback()
        conn.close()
        return False

def start_run_record(state_code, court_code):
    """Create a durable run-history row; file logs remain available if DB is down."""
    conn = get_postgres_connection()
    if not conn:
        return None
    try:
        cursor = conn.cursor()
        cursor.execute("INSERT INTO scraper_runs (started_at, state_code, court_code, status) VALUES (%s, %s, %s, 'running') RETURNING id", (datetime.now().astimezone(), state_code, court_code))
        run_id = cursor.fetchone()[0]
        conn.commit()
        cursor.close()
        conn.close()
        return run_id
    except Exception:
        conn.rollback()
        conn.close()
        logging.exception("Could not create database run-history record")
        return None

def finish_run_record(run_id, status, error=None):
    if run_id is None:
        return
    conn = get_postgres_connection()
    if not conn:
        return
    try:
        cursor = conn.cursor()
        cursor.execute("UPDATE scraper_runs SET finished_at=%s, status=%s, error=%s WHERE id=%s", (datetime.now().astimezone(), status, error, run_id))
        conn.commit()
        cursor.close()
        conn.close()
    except Exception:
        conn.rollback()
        conn.close()
        logging.exception("Could not update database run-history record")

def save_to_postgres(judge_name, cause_list_date, reference_name):
    """Insert one judge/date/reference record into PostgreSQL."""
    conn = get_postgres_connection()
    if not conn:
        if POSTGRES_ENABLED:
            raise RuntimeError("PostgreSQL connection failed while saving a cause-list record")
        return False

    try:
        cursor = conn.cursor()

        # Avoid duplicate judge + date + reference rows.
        check_query = """
        SELECT 1
        FROM ecourts_pdfs
        WHERE judge_name = %s
          AND cause_list_date = %s
          AND reference_name = %s
        LIMIT 1;
        """

        cursor.execute(
            check_query,
            (judge_name, cause_list_date, reference_name)
        )

        if cursor.fetchone():
            cursor.close()
            conn.close()
            return False

        insert_query = """
        INSERT INTO ecourts_pdfs
            (judge_name, cause_list_date, reference_name)
        VALUES
            (%s, %s, %s);
        """

        cursor.execute(
            insert_query,
            (judge_name, cause_list_date, reference_name)
        )

        conn.commit()
        cursor.close()
        conn.close()

        return True

    except Exception as e:
        print(f"Warning: Failed to insert into PostgreSQL: {e}")
        if conn:
            conn.rollback()
            conn.close()
        raise RuntimeError("Failed to insert cause-list record into PostgreSQL") from e


def save_cause_list_records_to_postgres(cause_lists):
    """
    Insert only:
      - judge_name
      - cause_list_date
      - reference_name

    Returns the number of newly inserted rows.
    """
    if not POSTGRES_ENABLED:
        return 0

    conn = get_postgres_connection()
    if not conn:
        raise RuntimeError("PostgreSQL connection failed while saving cause-list records")
    inserted = 0
    try:
        cursor = conn.cursor()
        for cl in cause_lists:
            judge_name = str(cl.get("judge", "")).strip()
            reference_name = str(cl.get("filename", "")).strip()
            cause_list_date = cl.get("date")
            if not judge_name or not reference_name or not cause_list_date:
                continue
            if hasattr(cause_list_date, "date"):
                cause_list_date = cause_list_date.date()
            cursor.execute("SELECT 1 FROM ecourts_pdfs WHERE judge_name=%s AND cause_list_date=%s AND reference_name=%s LIMIT 1", (judge_name, cause_list_date, reference_name))
            if cursor.fetchone():
                continue
            cursor.execute("INSERT INTO ecourts_pdfs (judge_name, cause_list_date, reference_name) VALUES (%s, %s, %s)", (judge_name, cause_list_date, reference_name))
            inserted += 1
        conn.commit()
        cursor.close()
        conn.close()
        return inserted
    except Exception as e:
        conn.rollback()
        conn.close()
        raise RuntimeError("Failed to save cause-list records to PostgreSQL") from e


def save_metadata_record(metadata_record):
    """Legacy compatibility wrapper. PostgreSQL uses the minimal 3-column path."""
    return save_to_postgres(
        metadata_record["judge_names"],
        metadata_record["cause_list_date"],
        metadata_record["pdf_filename"]
    )


