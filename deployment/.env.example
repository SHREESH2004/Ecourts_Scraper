# Supabase project credentials (publishable key is for its Data API, not PostgreSQL).
SUPABASE_URL=https://dvsjnzrouwywaqcacwsl.supabase.co
SUPABASE_KEY=sb_publishable_dv0mXIx0-25GOuJERAx78w_EKSCyHU6

# Optional alternative: Supabase Dashboard > Connect > connection string.
# For Vercel/serverless, use the Transaction pooler connection string (port 6543).
# If set, DATABASE_URL takes precedence over the individual DB_* settings.
DATABASE_URL=
# Supabase PostgreSQL connections require SSL.
DB_SSLMODE=require

# Supabase PostgreSQL direct connection settings.
DB_HOST=db.dvsjnzrouwywaqcacwsl.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
# Set this to the database password from Supabase Dashboard > Database Settings.
DB_PASSWORD=
PORT=5001

# Supabase Storage S3-compatible API (keep bucket private).
SUPABASE_S3_ENDPOINT_URL=https://dvsjnzrouwywaqcacwsl.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-northeast-1
SUPABASE_S3_BUCKET=Ecourts
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
